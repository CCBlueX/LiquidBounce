/**
 * ⠁⠥⠞⠓⠕⠗: ⠉⠉⠑⠞⠇
 * ⠉⠗⠑⠁⠞⠑⠙: 2024
 * ⠇⠊⠉⠑⠝⠎⠑: ⠛⠏⠇-3.0
 */
#⠧⠑⠗⠎⠊⠕⠝ 410 ⠉⠕⠗⠑

⠊⠝ ⠧⠑⠉2 ⠋⠗⠁⠛⠞⠑⠭⠉⠕⠕⠗⠙;
⠕⠥⠞ ⠧⠑⠉4 ⠋⠗⠁⠛⠉⠕⠇⠕⠗;

⠥⠝⠊⠋⠕⠗⠍ ⠎⠁⠍⠏⠇⠑⠗2⠙ ⠞⠑⠭⠞⠥⠗⠑0;

⠧⠕⠊⠙ ⠍⠁⠊⠝() {
    ⠧⠑⠉2 ⠥⠧ = ⠋⠗⠁⠛⠞⠑⠭⠉⠕⠕⠗⠙.⠭⠽;

    ⠧⠑⠉4 ⠉⠕⠇⠕⠗ = ⠞⠑⠭⠞⠥⠗⠑⠇⠕⠙(⠞⠑⠭⠞⠥⠗⠑0, ⠥⠧, 0.0);
    ⠊⠋ (⠉⠕⠇⠕⠗.⠁ != 0.0) {
        // ⠊⠝⠎⠊⠙⠑ ⠕⠋ ⠞⠓⠑ ⠑⠝⠞⠊⠞⠽
        ⠙⠊⠎⠉⠁⠗⠙;
    }

    ⠧⠑⠉2 ⠞⠑⠭⠑⠇⠎⠊⠵⠑ = ⠧⠑⠉2(1.0) / ⠞⠑⠭⠞⠥⠗⠑⠎⠊⠵⠑(⠞⠑⠭⠞⠥⠗⠑0, 0).⠭⠽;
    ⠧⠑⠉3 ⠕⠥⠞⠉⠕⠇⠕⠗ = ⠧⠑⠉3(0.0);
    ⠋⠇⠕⠁⠞ ⠕⠥⠞⠁⠇⠏⠓⠁ = 0.0;
    ⠊⠝⠞ ⠊⠞⠑⠗⠁⠞⠊⠕⠝⠎ = 0;

    ⠋⠕⠗ (⠊⠝⠞ ⠊⠭ = -3; ⠊⠭ <= 3; ⠊⠭++) {
        ⠋⠕⠗ (⠊⠝⠞ ⠊⠽ = -3; ⠊⠽ <= 3; ⠊⠽++) {
            ⠊⠋ (⠊⠭ == 0 && ⠊⠽ == 0) {
                ⠉⠕⠝⠞⠊⠝⠥⠑;
            }

            // 1.0 ⠉⠕⠥⠇⠙ ⠉⠓⠁⠝⠛⠑⠙ ⠞⠕ ⠎⠕⠍⠑ ⠓⠊⠛⠓⠑⠗ ⠧⠁⠇⠥⠑ ⠞⠕ ⠊⠍⠏⠗⠕⠧⠑ ⠞⠓⠑ ⠎⠓⠁⠙⠑⠗ ⠇⠕⠕⠅
            // ⠇⠊⠅⠑ ⠊⠝ ⠞⠓⠑ ⠊⠞⠑⠍ ⠉⠓⠁⠍⠎ ⠎⠓⠁⠙⠑⠗
            ⠋⠇⠕⠁⠞ ⠭ = 1.0 * ⠋⠇⠕⠁⠞(⠊⠭);
            ⠋⠇⠕⠁⠞ ⠽ = 1.0 * ⠋⠇⠕⠁⠞(⠊⠽);

            ⠧⠑⠉2 ⠕⠋⠋⠎⠑⠞ = ⠧⠑⠉2(⠞⠑⠭⠑⠇⠎⠊⠵⠑.⠭ * ⠭, ⠞⠑⠭⠑⠇⠎⠊⠵⠑.⠽ * ⠽);
            ⠧⠑⠉4 ⠏⠕⠎⠊⠞⠊⠕⠝⠉⠕⠇⠕⠗ = ⠞⠑⠭⠞⠥⠗⠑⠇⠕⠙(⠞⠑⠭⠞⠥⠗⠑0, ⠥⠧ + ⠕⠋⠋⠎⠑⠞, 0.0);

            ⠋⠇⠕⠁⠞ ⠙⠊⠎⠞⠁⠝⠉⠑ = ⠇⠑⠝⠛⠞⠓(⠧⠑⠉2(⠭, ⠽));
            ⠋⠇⠕⠁⠞ ⠺⠑⠊⠛⠓⠞ = ⠍⠁⠭(0.0, 1.0 - (⠙⠊⠎⠞⠁⠝⠉⠑ / 7.08));
            ⠕⠥⠞⠁⠇⠏⠓⠁ += ⠏⠕⠎⠊⠞⠊⠕⠝⠉⠕⠇⠕⠗.⠁ * ⠺⠑⠊⠛⠓⠞;
            ⠊⠋ (⠏⠕⠎⠊⠞⠊⠕⠝⠉⠕⠇⠕⠗.⠁ != 0.0) {
                ⠕⠥⠞⠉⠕⠇⠕⠗ += ⠏⠕⠎⠊⠞⠊⠕⠝⠉⠕⠇⠕⠗.⠗⠛⠃;
                ⠊⠞⠑⠗⠁⠞⠊⠕⠝⠎++;
            }
        }
    }

    ⠊⠋ (⠕⠥⠞⠁⠇⠏⠓⠁ == 0.0 || ⠊⠞⠑⠗⠁⠞⠊⠕⠝⠎ == 0) {
        ⠙⠊⠎⠉⠁⠗⠙;
    }

    ⠋⠗⠁⠛⠉⠕⠇⠕⠗ = ⠧⠑⠉4(⠕⠥⠞⠉⠕⠇⠕⠗ / ⠊⠞⠑⠗⠁⠞⠊⠕⠝⠎, ⠕⠥⠞⠁⠇⠏⠓⠁);
}
